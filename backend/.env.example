# Скопируйте в backend/.env и поправьте под себя. Файл .env в git не попадает.

# Рабочее соединение приложения. Роль rockcrm_app — НЕ владелец таблиц
# и НЕ суперпользователь: иначе PostgreSQL пропустит её мимо политик изоляции
# и защита тенантов превратится в декорацию.
DATABASE_URL=postgresql://rockcrm_app:app@localhost:55432/rockcrm_backend

# Административное соединение. Нужно только скриптам scripts/init_db.py
# и scripts/seed_demo.py: создать базу, накатить db/*.sql, выдать роли пароль.
ADMIN_DATABASE_URL=postgresql://postgres:dev@localhost:55432/postgres

APP_DB_NAME=rockcrm_backend
APP_DB_ROLE=rockcrm_app
APP_DB_PASSWORD=app

POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# Через запятую. В проде сузить до домена школы.
#
# «*» выключает куку с сессией: браузер не отдаёт учётные данные на ответ
# с Access-Control-Allow-Origin: *, и это запрет самого стандарта CORS,
# а не наша предосторожность. Для фронтенда нужен точный список.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Кука с сессией. Secure не ставится по http, поэтому на localhost выключено;
# в бою обязательно true — иначе сессию видно любому, кто слушает Wi-Fi школы.
AUTH_COOKIE_SECURE=false

# SameSite=Lax и есть защита от CSRF: браузер не приложит куку к межсайтовому
# POST, а всё, что меняет данные, у нас POST, PATCH и DELETE. Работает, пока
# фронтенд и API на одном сайте (домен и его поддомены; порт не учитывается).
# Значение none потребует отдельного CSRF-токена.
AUTH_COOKIE_SAMESITE=lax
