# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
# --- Database (152-ФЗ: только серверы в РФ, Yandex Cloud ru-central1 / Selectel) ---
DATABASE_URL=postgres://podacha:podacha@localhost:5432/podacha
# --- Auth ---
JWT_ES256_PRIVATE_KEY_PATH=./secrets/jwt.pem
GUEST_SESSION_TTL_SEC=14400
# --- PII encryption / search hash ---
PII_ENC_KEY=change-me-32-bytes-base64
PII_HMAC_KEY=change-me
# --- LLM (только российские провайдеры для ПДн) ---
LLM_PROVIDER=mock            # mock | yandexgpt | gigachat | selfhosted
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_API_KEY=
GIGACHAT_AUTH_KEY=
SELFHOSTED_LLM_BASE_URL=
LLM_ALLOWED_HOSTS=llm.api.cloud.yandex.net,gigachat.devices.sberbank.ru
# --- Integrations ---
POS_PROVIDER=mock            # mock | iiko | poster
PAYMENT_PROVIDER=mock        # mock | yookassa | tbank
# --- Bots ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
VK_GROUP_TOKEN=
