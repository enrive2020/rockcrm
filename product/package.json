{
  "name": "podacha-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["packages/shared", "packages/db", "packages/ai", "packages/integrations", "apps/api", "apps/bots", "apps/guest", "apps/admin"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present",
    "gen:zod": "node scripts/gen-zod.mjs",
    "dev:api": "npm run dev -w @podacha/api"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
