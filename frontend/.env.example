# Мок-режим: интерфейс работает без бэкенда на данных, собранных по контракту.
VITE_USE_MOCKS=true

# Базовый путь API. С dev-сервером запросы идут через прокси на VITE_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Заглушка авторизации из контракта: тенант и пользователь передаются заголовками.
# TODO: убрать после появления настоящего входа.
VITE_TENANT_ID=11111111-0000-4000-8000-000000000001
VITE_USER_ID=99999999-0000-4000-8000-000000000001

# Задержка мок-ответов, мс — чтобы состояние загрузки было видно, а не мигало.
VITE_MOCK_LATENCY_MS=320
