# Мок-режим: интерфейс работает без бэкенда на данных, собранных по контракту.
VITE_USE_MOCKS=true

# Базовый путь API. С dev-сервером запросы идут через прокси на VITE_PROXY_TARGET.
# Прокси здесь не для удобства: токен сессии лежит в куке HttpOnly, и одинаковый
# источник у страницы и API избавляет от CORS с учётными данными разом.
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Слаг школы для формы входа. В бою берётся из поддомена, здесь — запасной
# вариант для разработки.
VITE_TENANT_SLUG=rockschool-demo

# Роль мок-сессии: owner | admin | teacher | guardian | student.
VITE_MOCK_ROLE=owner
# true — моки стартуют без сессии, интерфейс покажет экран входа.
VITE_MOCK_SIGNED_OUT=false

# Задержка мок-ответов, мс — чтобы состояние загрузки было видно, а не мигало.
VITE_MOCK_LATENCY_MS=320

# Телефон и WhatsApp школы для кабинета родителя — ЗАПАСНОЙ вариант.
# Основной источник — `tenant.contacts` из GET /auth/me: в мультитенантном
# продукте телефон школы не может лежать в сборке фронтенда, иначе все школы
# получат один. Ключи существуют, пока поля нет в контракте (пробел 36).
VITE_SCHOOL_PHONE=+77273550101
VITE_SCHOOL_WHATSAPP=+77015550101
