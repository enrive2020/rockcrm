# Значения по умолчанию для разработки: бэкенд пишется параллельно,
# поэтому dev-сервер стартует на моках. Выключается VITE_USE_MOCKS=false.
VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Слаг школы, в которой открыт кабинет. В бою он берётся из поддомена
# (school.crm.kz → school); на машине разработчика поддомена нет, поэтому
# он задаётся здесь. Заголовков X-Tenant-Id больше не существует: школу
# определяет сессия, а слаг нужен только форме входа — телефон уникален
# внутри школы, но не между школами.
VITE_TENANT_SLUG=rockschool-demo

# Роль фиксированной мок-сессии: owner | admin | teacher | guardian | student.
# Это способ посмотреть все пять меню, не заводя пять учётных записей.
VITE_MOCK_ROLE=owner
# true — моки стартуют без сессии и показывают экран входа (код 123456,
# пароль rockschool). По умолчанию сессия уже есть: набирать код на каждой
# перезагрузке разработчику незачем.
VITE_MOCK_SIGNED_OUT=false

VITE_MOCK_LATENCY_MS=320
