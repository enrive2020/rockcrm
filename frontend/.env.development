# Значения по умолчанию для разработки: бэкенд пишется параллельно,
# поэтому dev-сервер стартует на моках. Выключается VITE_USE_MOCKS=false.
VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Идентификаторы демо-школы из backend/scripts/seed_demo.py. Держать в согласии
# с посевом обязательно: с чужим тенантом политики изоляции вернут пустоту,
# и экран будет выглядеть как «занятий нет», а не как ошибка доступа.
VITE_TENANT_ID=0189b0de-0000-7000-8000-00000000000a
VITE_USER_ID=0189b0de-0000-7000-8000-000000000091
VITE_MOCK_LATENCY_MS=320
